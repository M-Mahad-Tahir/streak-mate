# Copy to .env.local and fill in values from Supabase > Project Settings > API.
# These two values are PUBLIC by design (protected by Row Level Security).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public VAPID key for Web Push (optional). Generate with: npx web-push generate-vapid-keys
# The PRIVATE key must only be stored as a Supabase Edge Function secret, never here.
VITE_VAPID_PUBLIC_KEY=
